.login-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1677ff 0%, #40a9ff 100%);
}

.login-content {
  width: 100%;
  padding: 40px 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon {
  width: 100px;
  height: 100px;
  background-color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
}

.icon-text {
  font-size: 50px;
}

.login-title {
  font-size: 24px;
  font-weight: bold;
  color: white;
  margin-bottom: 12px;
}

.login-desc {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 40px;
}

/* ========== 登录卡片 ========== */
.login-card {
  width: 100%;
  background-color: white;
  border-radius: 16px;
  padding: 28px 24px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  margin-bottom: 32px;
}

.card-title {
  font-size: 18px;
  font-weight: 600;
  color: #1F2937;
  text-align: center;
  margin-bottom: 8px;
}

.card-desc {
  font-size: 13px;
  color: #6B7280;
  text-align: center;
  margin-bottom: 24px;
}

/* ========== 微信快捷登录按钮 ========== */
.wechat-login-btn {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #07C160;
  color: white;
  border: none;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 500;
  box-shadow: 0 4px 12px rgba(7, 193, 96, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn:active {
  opacity: 0.9;
}

.wechat-login-btn[disabled] {
  background-color: #8BD4A4;
  box-shadow: none;
}

/* ========== 安全提示 ========== */
.login-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20px;
  padding-top: 16px;
  border-top: 1px solid #F0F0F0;
}

.notice-icon {
  font-size: 14px;
  margin-right: 6px;
}

.notice-text {
  font-size: 12px;
  color: #9CA3AF;
}

.login-footer {
  margin-top: auto;
}

.footer-text {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
}
