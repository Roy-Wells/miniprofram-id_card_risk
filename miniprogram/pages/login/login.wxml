<view class="login-container">
  <view class="login-content">
    <view class="login-icon">
      <text class="icon-text">🔍</text>
    </view>
    <view class="login-title">风险信息查询</view>
    <view class="login-desc">欢迎使用身份证风险查询服务</view>

    <view class="login-card">
      <view class="card-title">微信快捷登录</view>
      <view class="card-desc">点击下方按钮，授权手机号完成登录</view>

      <button
        class="wechat-login-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="handleGetPhoneNumber"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        {{loading ? '登录中...' : '微信快捷登录'}}
      </button>

      <view class="login-notice">
        <text class="notice-icon">🔒</text>
        <text class="notice-text">手机号仅用于身份验证，不会泄露给第三方</text>
      </view>
    </view>

    <view class="login-footer">
      <text class="footer-text">信息加密传输，保护您的隐私安全</text>
    </view>
  </view>
</view>
