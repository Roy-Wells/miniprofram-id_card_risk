.admin-container {
  padding-top: 16px;
}

.tabs {
  display: flex;
  background-color: white;
  padding: 0 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  margin-bottom: 16px;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14px 0;
  font-size: 14px;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #1677ff;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40px;
  height: 3px;
  background-color: #1677ff;
  border-radius: 2px;
}

.query-tab {
  padding: 0 16px;
}

.query-section {
  margin-bottom: 20px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16px;
}

.form-item {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 14px;
  color: #666666;
  margin-bottom: 8px;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
}

.query-btn {
  width: 100%;
}

.result-section {
  margin-bottom: 20px;
}

.result-item {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  line-height: 1.6;
}

.result-label {
  min-width: 100px;
  font-size: 14px;
  color: #666666;
  flex-shrink: 0;
}

.result-value {
  font-size: 14px;
  color: #333333;
  word-break: break-all;
}

.status-tag {
  display: inline-block;
  font-size: 14px;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-weight: 600;
  vertical-align: middle;
}

.status-danger {
  color: #F53F3F;
  background-color: rgba(245, 63, 63, 0.1);
}

.status-warning {
  color: #FFAA00;
  background-color: rgba(255, 170, 0, 0.1);
}

.status-safe {
  color: #00B42A;
  background-color: rgba(0, 180, 42, 0.1);
}

.retry-btn {
  margin-top: 16px;
  width: 100%;
  height: 44px;
  line-height: 44px;
  background-color: #999999;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 14px;
}

.retry-btn:active {
  opacity: 0.8;
}

/* ========== 数据导入 Tab ========== */
.import-tab {
  padding: 0 16px;
}

.import-module {
  margin-bottom: 20px;
}

.module-title {
  font-size: 16px;
  font-weight: bold;
  color: #333333;
  margin-bottom: 4px;
}

.module-desc {
  font-size: 12px;
  color: #999999;
  margin-bottom: 16px;
}

.example-table {
  margin-bottom: 12px;
  border: 1px solid #e8e8e8;
  border-radius: 8px;
  overflow: hidden;
}

.table-row {
  display: flex;
}

.table-header {
  background-color: #f5f7fa;
  font-weight: 500;
}

.table-cell {
  flex: 1;
  padding: 10px 8px;
  font-size: 12px;
  color: #666666;
  text-align: center;
  border-right: 1px solid #e8e8e8;
}

.table-cell:last-child {
  border-right: none;
}

.notice-section {
  margin-bottom: 16px;
}

.notice-item {
  font-size: 12px;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 4px;
}

.notice-item::before {
  content: "•";
  margin-right: 4px;
}

.select-file-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  background-color: white;
  color: #1677ff;
  border: 1px solid #1677ff;
  border-radius: 8px;
  font-size: 14px;
  margin-bottom: 12px;
}

.select-file-btn:active {
  background-color: #f0f7ff;
}

.file-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  background-color: #f5f7fa;
  border-radius: 6px;
  margin-bottom: 12px;
}

.file-name {
  font-size: 12px;
  color: #333333;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 12px;
  color: #999999;
}

.import-btn {
  width: 100%;
}

.import-result {
  margin-top: 16px;
}

.result-summary {
  display: flex;
  margin-bottom: 12px;
  padding: 12px 0;
  border-top: 1px solid #f0f0f0;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-label {
  display: block;
  font-size: 12px;
  color: #666666;
  margin-bottom: 4px;
}

.summary-value {
  display: block;
  font-size: 20px;
  font-weight: bold;
  color: #333333;
}

.failures-detail {
  margin-top: 12px;
}

.failures-list {
  max-height: 200px;
  margin-bottom: 12px;
}

.failure-item {
  font-size: 12px;
  padding: 8px 0;
  border-bottom: 1px solid #f0f0f0;
}

.failure-row {
  color: #666666;
  margin-right: 4px;
}

.failure-reason {
  color: #ff4d4f;
}

.export-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  background-color: #52c41a;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 14px;
}

.export-btn:active {
  opacity: 0.8;
}

/* ========== 用户角色管理 ========== */
.user-manage {
  margin-top: 20px;
  padding-top: 16px;
  border-top: 1px solid #f0f0f0;
}

.manage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.manage-count {
  font-size: 12px;
  color: #999999;
}

.manage-actions {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.action-btn {
  flex: 1;
  height: 36px;
  line-height: 36px;
  font-size: 12px;
  border-radius: 6px;
  padding: 0;
  margin: 0;
}

.select-all-btn {
  background-color: #f5f7fa;
  color: #333333;
  border: 1px solid #d9d9d9;
}

.set-admin-btn {
  background-color: #1677ff;
  color: white;
  border: none;
}

.set-admin-btn[disabled] {
  background-color: #a0c4ff;
  color: rgba(255, 255, 255, 0.7);
}

.set-user-btn {
  background-color: white;
  color: #1677ff;
  border: 1px solid #1677ff;
}

.set-user-btn[disabled] {
  color: #a0c4ff;
  border-color: #a0c4ff;
}

.user-list {
  max-height: 300px;
}

.user-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #f5f5f5;
}

.user-info {
  display: flex;
  align-items: center;
  margin-left: 8px;
  flex: 1;
}

.user-phone {
  font-size: 14px;
  color: #333333;
  margin-right: 12px;
}

.user-role {
  font-size: 12px;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  font-weight: 500;
}

.role-admin {
  color: #1677ff;
  background-color: rgba(22, 119, 255, 0.1);
}

.role-user {
  color: #666666;
  background-color: #f5f5f5;
}
